# Copy to .env and fill with your Supabase project values
# Find in Supabase Dashboard -> Project Settings -> API
# NEVER commit .env (it holds the service_role secret)

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
# Get service_role from Dashboard -> Project Settings -> API -> service_role (secret!)
# Optional: use ANON_KEY only for read checks (service_role bypasses RLS)
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# Optional: yt-dlp tuning
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Cookies for private tracks (SoundCloud private etc)
# COOKIES_FILE=./cookies.txt

# Ingest tuning
POLL_INTERVAL_MS=10000
AUDIO_QUALITY=0
# 0=best 320k (~120 songs/GB), 5=~160k (~180 songs), 9=worst 128k (~285 songs/GB)
INGEST_CONCURRENCY=3
INGEST_BATCH_LIMIT=20
INGEST_MAX_ATTEMPTS=5
INGEST_SPAWN_TIMEOUT_MS=300000
